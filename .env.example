# ==========================================
# Site-da-mara (Next.js) - Variáveis de Ambiente
# ==========================================

# Supabase (Público)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica

# Supabase (Privado / Servidor)
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-privada

# Mercado Pago (Privado / Servidor)
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-seu-access-token-de-producao
MERCADO_PAGO_WEBHOOK_SECRET=seu-webhook-secret-do-painel-mp

# URLs e Configurações Gerais
NEXT_PUBLIC_SITE_URL=https://batatatopiacanga.com.br
ADMIN_EMAILS=admin@batatatop.com.br,outro@batatatop.com.br
